{
  "name": "oh-my-pi-desktop",
  "version": "0.4.0",
  "description": "Desktop chat client for the Oh My Pi coding agent",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "homepage": "https://oh-my-pi-desktop.pulse-core.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/dylansantwani/oh-my-pi-desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:watch": "vitest",
    "gen:icon": "node scripts/gen-icon.mjs",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:all": "electron-vite build && electron-builder --mac --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "fsevents": true
  },
  "build": {
    "appId": "com.ohmy.pi.desktop",
    "productName": "Oh My Pi Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "!node_modules/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dylansantwani",
        "repo": "oh-my-pi-desktop"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${name}-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Oh My Pi Desktop",
      "artifactName": "${name}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-win-${arch}-portable.${ext}"
    }
  }
}
